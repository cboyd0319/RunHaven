{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "run-control",
  "description": "Sensitive active-run access for one validated RunHaven run at a time.",
  "windows": ["main"],
  "permissions": [
    "allow-get-log-snapshot",
    "allow-get-managed-session-log-snapshot",
    "allow-stop-run",
    "allow-kill-run",
    "allow-repair-run",
    "allow-stop-managed-session",
    "allow-kill-managed-session",
    "allow-repair-managed-session"
  ]
}
