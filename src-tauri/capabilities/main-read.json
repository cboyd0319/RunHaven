{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-read",
  "description": "Read-only access for RunHaven setup, dashboard, profile, image status, managed session status, run status, planning, and secret-free diagnostics commands.",
  "windows": ["main"],
  "permissions": [
    "allow-get-setup-status",
    "allow-list-agents",
    "allow-get-dashboard-status",
    "allow-get-image-status",
    "allow-get-image-build-status",
    "allow-get-network-prune-preview",
    "allow-get-run-status",
    "allow-plan-run",
    "allow-get-egress-log",
    "allow-get-auth-log",
    "allow-get-auth-status",
    "allow-get-auth-explain",
    "allow-get-why-network",
    "allow-get-why-state",
    "allow-get-why-host",
    "allow-get-why-workspace",
    "allow-get-managed-sessions",
    "allow-get-managed-session-status",
    "allow-get-managed-session-diagnostics",
    "allow-get-managed-session-worktree",
    "allow-get-launch-status"
  ]
}
