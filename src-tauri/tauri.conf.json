{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunHaven",
  "version": "0.7.0",
  "identifier": "dev.runhaven.desktop",
  "build": {
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "RunHaven",
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        "main-read",
        "setup-recovery",
        "folder-pick",
        "launch-run",
        "run-control",
        "menu-events",
        "menu-state",
        "attention-badge",
        "terminal",
        "window-chrome"
      ]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["../docs/assets/logo.png"],
    "macOS": {
      "hardenedRuntime": true,
      "minimumSystemVersion": "26.0"
    }
  }
}
